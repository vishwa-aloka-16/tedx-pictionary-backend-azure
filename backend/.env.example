# Comma-separated frontend origins; replace with the deployed HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Admin password (12–256 characters). Blank disables Admin access.
# Never place this value in the frontend or a VITE_ variable.
ADMIN_PASSWORD=
# Relative to backend/, or an absolute path on a persistent volume.
LEADERBOARD_PATH=leaderboard.sqlite3
# Public origin of qr-to-image-hosted (blank keeps the current local artwork page).
ARTWORK_SHARE_URL=
# Must exactly match UPLOAD_API_KEY in qr-to-image-hosted; server-side only.
ARTWORK_SHARE_UPLOAD_KEY=
