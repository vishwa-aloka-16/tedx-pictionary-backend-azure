# Comma-separated frontend origins; replace with the deployed HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Admin password (12–256 characters). Blank disables Admin access.
# Never place this value in the frontend or a VITE_ variable.
ADMIN_PASSWORD=
# Local SQLite leaderboard (URL blank) or durable delivery outbox (URL configured).
# On Azure, keep this under /home/data; relative paths resolve under backend/.
LEADERBOARD_PATH=leaderboard.sqlite3
# Existing Node service origin. Also enables remote MongoDB leaderboard storage.
# Blank keeps local SQLite leaderboard and local artwork sharing.
ARTWORK_SHARE_URL=
# Same existing UPLOAD_API_KEY, reused for artwork and game-data APIs. Server-side only.
ARTWORK_SHARE_UPLOAD_KEY=
